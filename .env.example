# Required in production: the canonical public HTTPS origin, without a path.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SERVER_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
# Set true only when the reverse proxy overwrites forwarding headers with the client IP.
TRUSTED_PROXY_HEADERS=false
